# Runtime environment. "production" turns on strict checks: the server refuses to start
# with a missing/placeholder SECRET_KEY and refuses to seed a default admin password.
ENV=development

# Database Configuration
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=production_log

# First-Startup Admin Seed
# These credentials are used ONCE to create the initial admin user when the DB is empty.
# Change them before deploying to production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_production
ADMIN_EMAIL=admin@factory.local

# AI read-only DB user (Text-to-SQL agent; granted SELECT-only access at startup)
AI_DB_USER=ai_analyst
AI_DB_PASSWORD=your_ai_db_password

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Initial Telegram admin (auto-seeded on first startup)
INIT_ADMIN_TG_ID=
INIT_ADMIN_USERNAME=admin

# Google Drive Configuration (OAuth 2.0 Desktop Client ID)
# Download your OAuth 2.0 Desktop Client ID JSON from Google Cloud Console
# This should be a "Desktop application" credentials file, NOT a Service Account
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Token file will be created automatically after first authentication
GOOGLE_TOKEN_PATH=./token.json
# The folder ID where PDFs will be uploaded (create a folder in Google Drive and get its ID)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# PDF Archive Path (Windows Server path)
LOCAL_PDF_ARCHIVE_PATH=C:\src\production_log\pdf_archive
#New releases folder
APK_RELEASES_DIR=C:\src\production_log\production_api\apk_releases

# Admin Panel Configuration (SQLAdmin) + API bearer-token signing
# Generate a secure random key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-very-secure-random-key-change-in-production
# Optional: bearer-token lifetime in seconds (defaults to 604800 = 7 days)
AUTH_TOKEN_TTL_SECONDS=604800

# Telegram Bot Maintenance Mode
# Set to "true" to block all interactive bot commands (/start, menus, callbacks)
# while keeping report submission notifications running normally.
# Requires server restart to take effect.
BOT_MAINTENANCE_MODE=false
# AI Analysis Configuration
# Supports any OpenAI-compatible API (OpenAI, Azure OpenAI, Groq, Ollama, etc.)
AI_ENABLED=true
AI_API_KEY=your_ai_api_key_here
# OpenAI: https://api.openai.com/v1
# Groq:   https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Telegram Admin Access for AI Queries
# Comma-separated Telegram user IDs allowed to use /ai command in the bot.
# Get your user ID by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_USER_IDS=123456789,987654321

# ---------------------------------------------------------------------------
# Station watcher (integrated ingester, replaces Data_Bridge desktop daemon).
# Pull-mode watch folders are configured in the Web UI (Settings -> Quality
# Stations) and stored in station_profiles.watch_path — the watcher re-reads
# them every scan, so no restart is needed. The vars below are OPTIONAL legacy
# static fallbacks only.
# ---------------------------------------------------------------------------
STATION_WATCH_PATH=
STATION_WATCH_PATHS=
# How often to scan for new files, in seconds.
STATION_SCAN_INTERVAL=30
# Station column used to identify the machine (maker=1 / maker=2).
STATION_MACHINE_ALIAS_FIELD=maker
# Which station column carries the Manufacturing Order number:
#   batch_description (default) | comments | brand
STATION_MO_FIELD=batch_description

# Plant local timezone used to interpret naive station timestamps (Produced On,
# Batch Started On, ...). IANA name; Europe/Budapest = Central Europe.
MES_PLANT_TIMEZONE=Europe/Budapest

# Public base URL used when generating the station agent ZIP bundle (defaults to
# the request's origin). Set this when the server is behind NAT / a reverse proxy.
# MES_PUBLIC_BASE_URL=http://10.10.0.202:8000

# Flutter web build directory served by the backend (SPA fallback).
# Defaults to frontend/build/web relative to the repo root.
# WEB_BUILD_DIR=/app/frontend/build/web

# ---------------------------------------------------------------------------
# Odoo ERP integration (Community 18, XML-RPC /xmlrpc/2 with API key).
# Leave ODOO_ENABLED=false to keep the connector fully inert.
# ---------------------------------------------------------------------------
ODOO_ENABLED=false
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=mes_integration
ODOO_API_KEY=your_odoo_api_key_here
# Shared secret used to HMAC-sign the Odoo -> MES webhook (POST /v2/odoo/mo-event).
# Must match the Odoo system parameter ``mes_pft.webhook_secret``. Leave empty to
# disable signature verification (development only).
ODOO_WEBHOOK_SECRET=

# Shadow mode: the dispatcher reads from Odoo for real but only RECORDS the writes it
# would make (odoo_shadow_log). Run with true for a trial period, then set false and
# POST /api/v2/odoo/shadow/requeue to post the shadowed items for real.
ODOO_SHADOW_MODE=true
# Reject webhook calls that are not signed with a timestamp (set true once the addon is upgraded).
ODOO_WEBHOOK_REQUIRE_TIMESTAMP=false

# Background reconciliation of linked Odoo orders (state, current open MO). 0 disables.
ODOO_RECONCILE_MINUTES=10
