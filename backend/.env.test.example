# LOCAL TEST database (clone of production). Copy to backend/.env.test.
# Used by the web_test compose service AND by local uvicorn/alembic runs.
# The test DB runs in container mes_db_test on host port 5433.

DB_USER=postgres
DB_PASSWORD=test_password
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=mes_test_db

# Test-only signing secret (never reuse the production SECRET_KEY).
SECRET_KEY=test-only-secret-key
ENV=development